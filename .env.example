# Copy to .env and fill in. Everything is optional; missing integrations degrade to "queued".

# Which customer YAML to load (customers/<id>.yaml)
CCR_CUSTOMER=harlow-pryce

# Review engine override. Empty = use the customer's setting.
#   keyword | retrieval-bm25 | retrieval-dense | retrieval-hybrid | llm
CCR_REVIEWER=

# Air-gapped mode. 1 = block every outbound HTTP call and force the local engine.
CCR_OFFLINE=0

# Public URL used in notifications
CCR_BASE_URL=http://localhost:8000

# LLM extraction (only for CCR_REVIEWER=llm). Never commit this.
ANTHROPIC_API_KEY=
CCR_LLM_MODEL=claude-sonnet-4-5

# HubSpot private app token with crm.objects.deals.* and crm.objects.notes.* scopes
HUBSPOT_PRIVATE_APP_TOKEN=

# Slack incoming webhook for the review channel, and the app signing secret for inbound
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Postgres password for docker compose (SQLite is used when running locally without compose)
POSTGRES_PASSWORD=change-me
